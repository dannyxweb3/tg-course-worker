# ============ 你自己 ============
# 你的 Telegram 数字 user id（生产 Bot 只响应这个 id）
# 拿法：给 @userinfobot 发条消息
OWNER_ID=123456789

# ============ Bot token ============
# ⚠️ token 只存在这里，**不进数据库**。库里存的是下面这些变量名。
# 后台新增 bot 时，填一个新的变量名（如 BOT_EN），再回这里加一行。
PRODUCER_BOT_TOKEN=123456:AAA...
SALE_BOT_TOKEN=123456:BBB...
# 例：第二个频道的发布 bot
# BOT_EN=123456:CCC...

# ============ 引导用（只有 scripts/bootstrap.py 读）============
# 第一个频道的 chat_id，形如 -1001234567890
# 拿法：把发布 bot 设为频道管理员后，在频道发条消息转发给 @userinfobot
CHANNEL_ID=-1001234567890
CHANNEL_NAME=AI 自动化主号

# ============ LLM ============
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_CLASSIFY=deepseek-chat
MODEL_GENERATE=deepseek-chat
MODEL_REWRITE=deepseek-reasoner

# ============ 全局默认 ============
TIMEZONE=Asia/Shanghai
# 新建频道的默认排期（标准 5 段 cron）
DEFAULT_PUBLISH_CRON=0 9 * * *
# 相关性低于此值直接建议丢弃（0-10）
RELEVANCE_THRESHOLD=5
# 队列低于此条数时提醒补货
QUEUE_LOW_WATERMARK=3
# 每天几点做频道健康检查（bot 是否还在频道、有没有发布权限）
HEALTH_CHECK_HOUR=8

# ============ 管理后台 ============
WEB_ENABLED=true
# 默认只绑本机。访问方式：ssh -L 8080:127.0.0.1:8080 user@server
# 要对外暴露自己加反代 + HTTPS，别直接改成 0.0.0.0
WEB_HOST=127.0.0.1
WEB_PORT=8080
# 登录密码。留空则后台完全不启动
WEB_PASSWORD=
# session 签名密钥，随便一串长随机字符串
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
WEB_SECRET=
